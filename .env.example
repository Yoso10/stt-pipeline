# How to run: copy this file to ".env" (which git ignores) and edit the values for this machine.
#     copy .env.example .env
# Only machine-specific settings belong here. Format: KEY=VALUE, "#" starts a comment.
# Names use the form STT__SECTION__KEY and override the YAML file (the command line overrides both).
# Real environment variables win over this file.

# Example: allow online mode at home only. Leave it out (or false) on the closed machine.
# STT__RUNTIME__ONLINE=true

# Example: change the seed for this machine.
# STT__RUNTIME__SEED=42
